# Crawlee MCP Server

# Optional: Comma-separated proxy URLs for rotation
# CRAWLEE_PROXY_URLS=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080

# Optional: Request timeout in milliseconds (default: 30000)
# CRAWLEE_TIMEOUT_MS=30000

# Optional: Disable stealth mode (default: true)
# CRAWLEE_STEALTH=true
