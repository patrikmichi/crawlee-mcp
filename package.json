{
  "name": "@patrikmichi/crawlee-mcp",
  "version": "1.1.0",
  "type": "module",
  "description": "A local stdio MCP server for web fetching, crawling, and screenshots with Crawlee.",
  "bin": {
    "crawlee-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "env.example"
  ],
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "crawlee",
    "web-scraping",
    "playwright",
    "claude",
    "codex"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrikmichi/crawlee-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/patrikmichi/crawlee-mcp/issues"
  },
  "homepage": "https://github.com/patrikmichi/crawlee-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "cheerio": "^1.2.0",
    "crawlee": "^3.16.0",
    "playwright": "^1.58.0",
    "turndown": "^7.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
