{
  "name": "@patrikmichi/crawlee-mcp",
  "version": "1.1.0",
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "description": "A local stdio MCP server for web fetching, crawling, and screenshots with Crawlee.",
  "bin": {
    "crawlee-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "env.example"
  ],
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "crawlee",
    "web-scraping",
    "playwright",
    "claude",
    "codex"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrikmichi/crawlee-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/patrikmichi/crawlee-mcp/issues"
  },
  "homepage": "https://github.com/patrikmichi/crawlee-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.2.0",
    "crawlee": "^3.18.2",
    "playwright": "^1.64.1",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
